{
  "version": 1,
  "emulator": {
    "adb_path": "builtin",
    "serial": "auto",
    "executable": "",
    "arguments": [],
    "launch_delay": 10,
    "stop_after_run": false,
    "package": "com.miHoYo.HSoDv2BiliBiliRelease"
  },
  "runtime": {
    "template_dir": "templates",
    "run_dir": "runs",
    "image_timeout": 12,
