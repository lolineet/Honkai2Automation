  "notifications": {
    "on_success": true,
    "on_error": true,
    "webhooks": [],
    "email": {
      "enabled": false,
      "provider": "qq",
      "qq_number": "",
      "host": "smtp.qq.com",
      "port": 465,
      "security": "ssl",
      "username": "",
      "sender": "",
      "recipient": "",
      "password_env": "HKA_SMTP_PASSWORD"
    }
  },
  "tasks": [
    {
      "id": "launch",
      "name": "启动崩坏2",
      "kind": "daily",
      "enabled": true,
      "schedule": {
        "type": "daily"
      },
      "steps": [
        {
          "type": "launch_game",
          "wait": 20
        },
        {
          "type": "game_flow",
          "flow": "enter_game"
        }
